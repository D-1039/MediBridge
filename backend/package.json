{
  "name": "medibridge-backend",
  "version": "1.0.0",
  "description": "MediBridge API – medicine redistribution backend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:start": "node scripts/embedded-postgres-dev.js",
    "dev:clean": "powershell -ExecutionPolicy Bypass -File scripts/kill-port.ps1 -Port 5000 && nodemon server.js",
    "migrate": "node src/database/migrate.js",
    "migrate:down": "node src/database/migrate.js down",
    "seed": "node scripts/seed-demo-users.js",
    "check-vision": "node scripts/check-vision.js",
    "check-ocr": "node scripts/check-ocr.js",
    "test": "jest --runInBand --forceExit",
    "test:watch": "jest --watch"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@google-cloud/vision": "^4.3.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "firebase-admin": "^13.0.2",
    "fuse.js": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.13.3",
    "sharp": "^0.34.5",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.0.5"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "pg-embedded": "^0.2.3",
    "supertest": "^7.0.0"
  }
}
