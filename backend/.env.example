# Server
NODE_ENV=development
PORT=5000
API_BASE_URL=http://localhost:5000

# PostgreSQL (Neon)
DATABASE_URL=postgresql://user:password@host.neon.tech/medibridge?sslmode=require

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

# CORS (comma-separated origins)
# Optional — if unset, localhost:3000–3006 are allowed in development
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003

# Firebase Storage
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# OCR engine: tesseract (free, no billing) | auto | google_vision
OCR_ENGINE=tesseract

# Google Cloud Vision (optional — needs billing enabled on GCP)
GOOGLE_VISION_API_KEY=your-api-key-here
# Or service account JSON file:
GOOGLE_APPLICATION_CREDENTIALS=./service-account-vision.json
# GCP_VISION_CLIENT_EMAIL=
# GCP_VISION_PRIVATE_KEY=

# Local file uploads when Firebase is not configured (auto in development)
USE_LOCAL_STORAGE=true

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
# Development: 5000+. Production: 100–300
RATE_LIMIT_MAX=5000

# Safety engine
SAFETY_LOW_OCR_THRESHOLD=0.65
SAFETY_EXPIRY_WARNING_DAYS=90
